{
  "info": {
    "name": "LMS - Credentials Flow",
    "description": "Test how credentials appear when admin/license user assigns a course. Run migration first: `npx prisma migrate dev` in lms folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_api", "value": "http://localhost:5000/api/v1" },
    { "key": "company_admin_token", "value": "" },
    { "key": "license_user_token", "value": "" },
    { "key": "employee_token", "value": "" },
    { "key": "student_token", "value": "" },
    { "key": "courseId", "value": "0c227f68-acb2-4b69-ab4c-241a1de6ea5f" },
    { "key": "employeeUserId", "value": "" },
    { "key": "companyCoursePurchaseId", "value": "" },
    { "key": "credentialId", "value": "" },
    { "key": "employee_email", "value": "employee.test@example.com" }
  ],
  "item": [
    {
      "name": "0 - Setup",
      "item": [
        {
          "name": "Company Admin Login (OTP step 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"company-admin@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": "{{base_api}}/auth/signin"
          }
        },
        {
          "name": "Company Admin Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.tokens?.accessToken || json?.data?.accessToken || json?.accessToken;",
                  "if (token) pm.collectionVariables.set('company_admin_token', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"company-admin@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{base_api}}/auth/verify-login-otp"
          }
        },
        {
          "name": "License User Login (OTP step 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"license@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": "{{base_api}}/auth/signin"
          }
        },
        {
          "name": "License User Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.tokens?.accessToken || json?.data?.accessToken || json?.accessToken;",
                  "if (token) pm.collectionVariables.set('license_user_token', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"license@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{base_api}}/auth/verify-login-otp"
          }
        }
      ]
    },
    {
      "name": "1 - Company Admin assigns course",
      "item": [
        {
          "name": "Create employee + assign course",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const employee = json?.data?.employee || json?.data?.data?.employee;",
                  "if (employee?.userId) pm.collectionVariables.set('employeeUserId', employee.userId);",
                  "if (employee?.id) pm.collectionVariables.set('employeeUserId', employee.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{company_admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Mario\",\n  \"lastName\": \"Rossi\",\n  \"email\": \"{{employee_email}}\",\n  \"contactNumber\": \"+39333111222\",\n  \"role\": \"Operatore\",\n  \"employmentDate\": \"2026-01-15\",\n  \"courseIds\": [\"{{courseId}}\"]\n}"
            },
            "url": "{{base_api}}/employees"
          }
        },
        {
          "name": "Assign course to existing employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{company_admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseIds\": [\"{{courseId}}\"]\n}"
            },
            "url": "{{base_api}}/employees/{{employeeUserId}}/assign-courses"
          }
        },
        {
          "name": "Invite employee via corporate purchase",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{company_admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyCoursePurchaseId\": \"{{companyCoursePurchaseId}}\",\n  \"email\": \"new.invite@example.com\",\n  \"firstName\": \"Luigi\",\n  \"lastName\": \"Bianchi\",\n  \"jobTitle\": \"Tecnico\"\n}"
            },
            "url": "{{base_api}}/company-purchases/invite-employee"
          }
        }
      ]
    },
    {
      "name": "2 - License user assigns course",
      "item": [
        {
          "name": "Create enrollment (single user)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{license_user_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\",\n  \"userId\": \"{{employeeUserId}}\"\n}"
            },
            "url": "{{base_api}}/enrollments"
          }
        },
        {
          "name": "Bulk enroll users",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{license_user_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\",\n  \"userIds\": [\"{{employeeUserId}}\"]\n}"
            },
            "url": "{{base_api}}/enrollments/bulk"
          }
        }
      ]
    },
    {
      "name": "3 - Student reads credentials",
      "item": [
        {
          "name": "Employee Login (OTP step 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employee_email}}\",\n  \"password\": \"TEMP_PASSWORD_FROM_CREATE_RESPONSE\"\n}"
            },
            "url": "{{base_api}}/auth/signin"
          }
        },
        {
          "name": "Employee Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.tokens?.accessToken || json?.data?.accessToken || json?.accessToken;",
                  "if (token) {",
                  "  pm.collectionVariables.set('employee_token', token);",
                  "  pm.collectionVariables.set('student_token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employee_email}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{base_api}}/auth/verify-login-otp"
          }
        },
        {
          "name": "GET my credentials (latest + list)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const latest = json?.data?.latest || json?.data?.data?.latest;",
                  "if (latest?.id) pm.collectionVariables.set('credentialId', latest.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employee_token}}" }
            ],
            "url": {
              "raw": "{{base_api}}/users/me/credentials",
              "host": ["{{base_api}}"],
              "path": ["users", "me", "credentials"]
            }
          }
        },
        {
          "name": "GET unread credentials only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employee_token}}" }
            ],
            "url": {
              "raw": "{{base_api}}/users/me/credentials?unreadOnly=true",
              "host": ["{{base_api}}"],
              "path": ["users", "me", "credentials"],
              "query": [{ "key": "unreadOnly", "value": "true" }]
            }
          }
        },
        {
          "name": "PATCH mark credential viewed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employee_token}}" }
            ],
            "url": "{{base_api}}/users/me/credentials/{{credentialId}}/viewed"
          }
        }
      ]
    }
  ]
}
