{
  "info": {
    "name": "LMS - Student Lesson Complete Flow",
    "description": "Student enrolled course complete করার full flow — lessons + quiz + certificate.\n\nCourse ID: d2843463-b795-4884-a918-4d2def2e5ca9\n\nSetup:\n1. student_token set করো\n2. Run: 01 Get Course Progress\n3. Run: 02 Get All Lessons (auto-saves lessonId_1..lessonId_9)\n4. Run lesson complete 03-11 sequentially\n5. Run quiz 12-14\n6. Run verify 15-17",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_api",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "student_token",
      "value": ""
    },
    {
      "key": "courseId",
      "value": "d2843463-b795-4884-a918-4d2def2e5ca9"
    },
    {
      "key": "lessonId_1",
      "value": ""
    },
    {
      "key": "lessonId_2",
      "value": ""
    },
    {
      "key": "lessonId_3",
      "value": ""
    },
    {
      "key": "lessonId_4",
      "value": ""
    },
    {
      "key": "lessonId_5",
      "value": ""
    },
    {
      "key": "lessonId_6",
      "value": ""
    },
    {
      "key": "lessonId_7",
      "value": ""
    },
    {
      "key": "lessonId_8",
      "value": ""
    },
    {
      "key": "lessonId_9",
      "value": ""
    },
    {
      "key": "quizId_final",
      "value": ""
    },
    {
      "key": "enrollmentId",
      "value": ""
    },
    {
      "key": "certificateId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "STUDENT FLOW",
      "item": [
        {
          "name": "01 - Get Course Progress (Dashboard %)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/courses/{{courseId}}/lessons/progress"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.progress?.enrollment?.id) {",
                  "  pm.collectionVariables.set('enrollmentId', res.data.progress.enrollment.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Get All Lessons (auto-save lesson IDs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/courses/{{courseId}}/lessons?limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const lessons = res.data?.lessons || [];",
                  "lessons.sort((a,b) => a.orderIndex - b.orderIndex);",
                  "lessons.forEach((l, i) => {",
                  "  if (i < 9) pm.collectionVariables.set(`lessonId_${i+1}`, l.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Lesson 1 Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/courses/{{courseId}}/lessons/{{lessonId_1}}/status"
          }
        },
        {
          "name": "04 - Lesson 1 Detail (video player)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/courses/{{courseId}}/lessons/{{lessonId_1}}?includeProgress=true"
          }
        },
        {
          "name": "05 - Lesson 1 Complete",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true,\n  \"timeSpentSecs\": 600\n}"
            },
            "url": "{{base_api}}/courses/{{courseId}}/lessons/{{lessonId_1}}/progress"
          }
        },
