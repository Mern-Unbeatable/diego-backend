{
  "info": {
    "name": "LMS - Video Course Full Test (Correct Format)",
    "description": "Matches actual quiz.validation.js format. Quiz is created under COURSE (not lesson).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_api", "value": "http://localhost:5000/api/v1" },
    { "key": "admin_token", "value": "" },
    { "key": "student_token", "value": "" },
    { "key": "tenantId", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "lessonId_1", "value": "" },
    { "key": "lessonId_2", "value": "" },
    { "key": "quizId", "value": "" },
    { "key": "enrollmentId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Admin - Create Video Course",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseTitle\": {\n    \"en\": \"Complete Web Development Bootcamp\",\n    \"it\": \"Bootcamp Completo di Sviluppo Web\"\n  },\n  \"slug\": \"web-dev-bootcamp-2026\",\n  \"category\": \"CATALOG\",\n  \"format\": \"VIDEO_RECORDED\",\n  \"navigationMode\": \"SEQUENTIAL\",\n  \"description\": {\n    \"en\": \"Programming Hero style course: HTML, CSS, JavaScript, React.\",\n    \"it\": \"Corso stile Programming Hero.\"\n  },\n  \"durationMinutes\": 1200,\n  \"validityDays\": 365,\n  \"passScorePercent\": 80,\n  \"price\": 0,\n  \"basePrice\": 0,\n  \"isActive\": true,\n  \"isB2BOnly\": false,\n  \"tenantId\": \"{{tenantId}}\"\n}"
        },
        "url": "{{base_api}}/courses"
      }
    },
    {
