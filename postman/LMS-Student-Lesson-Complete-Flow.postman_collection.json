          }
        },
        {
          "name": "14 - Get Available Quizzes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/quizzes/{{courseId}}/available"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const quizzes = res.data?.quizzes || [];",
                  "const finalQuiz = quizzes.find(q => q.quizType === 'FINAL_TEST');",
                  "if (finalQuiz) pm.collectionVariables.set('quizId_final', finalQuiz.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "15 - Start FINAL_TEST Quiz",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/quizzes/{{courseId}}/start-quiz/{{quizId_final}}"
          }
        },
        {
          "name": "16 - Submit FINAL_TEST (100% pass)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"questionId\": \"q1\", \"selectedOptionIds\": [\"q1-a\"] },\n    { \"questionId\": \"q2\", \"selectedOptionIds\": [\"q2-a\"] },\n    { \"questionId\": \"q3\", \"selectedOptionIds\": [\"q3-a\"] },\n    { \"questionId\": \"q4\", \"selectedOptionIds\": [\"q4-a\"] },\n    { \"questionId\": \"q5\", \"selectedOptionIds\": [\"q5-a\"] }\n  ]\n}"
            },
            "url": "{{base_api}}/quizzes/{{courseId}}/submit/{{quizId_final}}"
          }
        },
        {
          "name": "17 - Verify Course COMPLETED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/courses/{{courseId}}/lessons/progress"
          }
        },
        {
          "name": "18 - Get My Certificates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/certificates/my"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const certs = res.data?.certificates || res.data || [];",
                  "if (Array.isArray(certs) && certs[0]?.id) {",
                  "  pm.collectionVariables.set('certificateId', certs[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "19 - Download Certificate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{base_api}}/certificates/{{certificateId}}/download"
          }
        }
      ]
    },
