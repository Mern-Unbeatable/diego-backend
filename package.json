{
  "name": "diego-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/bootstrap.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "dev": "nodemon --config nodemon.json src/bootstrap.js",
    "dev:clean": "sh -c 'fuser -k 5000/tcp 2>/dev/null || true; exec nodemon --config nodemon.json src/bootstrap.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seeds:admin": "node src/seeds/admin.seeder.js",
    "seeds:package": "node src/seeds/package.seeder.js",
    "seeds:course-package": "node src/seeds/seed-course-packages.js",
    "seeds:archive-plan": "node src/seeds/certificate-archive-plan.seeder.js",
    "seeds:video-lessons": "node src/seeds/video-course-lessons.seeder.js",
    "seeds:video-quiz": "node src/seeds/video-course-quiz.seeder.js",
    "seeds:scorm-lessons": "node src/seeds/scorm-course-lessons.seeder.js",
    "seeds:scorm-setup": "node src/seeds/scorm-setup.js",
    "seeds:course-demo": "node src/seeds/seed-course-demo.js",
    "seeds:course-demo:force": "FORCE_SEED=true node src/seeds/seed-course-demo.js",
    "seeds:prod-demo": "pnpm run prisma:deploy && pnpm run seeds:course-demo",
    "repair:certificates": "node src/scripts/repair-missing-certificates.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  },
  "lint-staged": {
    "*.{js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-pdf-node": "^1.0.8",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "stripe": "^22.1.0",
    "swagger-stats": "^0.99.7",
    "twilio": "^5.13.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
