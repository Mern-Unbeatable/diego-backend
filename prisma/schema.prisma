generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupportedLocale {
  it
  en
  fr
  zh
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum StaffRole {
  TRAINING_PROJECT_MANAGER
  CONTENT_MENTOR_TUTOR
  PROCESS_TUTOR
  PLATFORM_DEVELOPER
}

enum StaffDocumentType {
  CURRICULUM
  HEALTH_SAFETY_CERTIFICATE
  DIGITAL_SKILLS_CERTIFICATE
  IDENTITY_CARD_TAX_CODE
  CHAMBER_OF_COMMERCE_CERTIFICATE
}

enum StaffMemberStatus {
  DRAFT
  CONFIRMED
}

enum UserLevel {
  PRIVATE_USER
  COMPANY_ADMIN
  COMPANY_EMPLOYEE
  LICENSE_USER
  PLATFORM_ADMIN
  TUTOR
  TEACHER
}

enum ServiceRequestStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

enum CourseFormat {
  SCORM
  PDF
  AICC
  XAPI
  VIDEO_RECORDED
  FILE
  EXERCISE
  HTML_PAGE
  SURVEY
  TEST
  CHECKLIST
  SLIDES_CONVERTER
  LTI
}

enum NavigationMode {
  SEQUENTIAL
  FREE
  LOCKED_FINAL
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  SUSPENDED
}

enum CertificateStatus {
  PENDING
  ISSUED
  ARCHIVED
  REVOKED
}

enum PaymentType {
  SINGLE_COURSE
  PACKAGE
  LICENSE
  ARCHIVE_STORAGE
  COUPON
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  NOT_REQUESTED
  PENDING
  ISSUED
  FAILED
}

enum AlertSeverity {
  YELLOW
  RED
}

enum QuizType {
  PRE_TEST
  POST_TEST
  FINAL_TEST
}

enum Citizenship {
  ITALIAN
  FOREIGN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AntiCheatEvent {
  MOUSE_IDLE
  TAB_CHANGE
  WINDOW_BLUR
  FULLSCREEN_EXIT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CouponTarget {
  COURSE
  PACKAGE
  LICENSE
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

enum LicensePlanTier {
  BEGINNER
  STANDARD
  PREMIUM
  ENTERPRISE
}

model CoursePricingTier {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  minUsers     Int
  maxUsers     Int?
  pricePerUser Float

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model CompanyCoursePurchase {
  id        String  @id @default(uuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  seatsTotal   Int
  seatsUsed    Int   @default(0)
  pricePerUser Float
  totalAmount  Float

  purchasedAt DateTime @default(now())
  expiresAt   DateTime

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  enrollments Enrollment[]
  renewals    CompanyCoursePurchaseRenewal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([courseId])
}

model LicensePlan {
  id           String          @id @default(uuid())
  tier         LicensePlanTier @unique
  name         Json
  description  Json?
  features     Json?
  supportLevel Json?

  maxUsers     Int
  priceMonthly Float
  priceYearly  Float?
  priceAnnual  Float?
  storageMb    Int    @default(10240)
  maxCourses   Int    @default(100)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses        License[]
  licenseRenewals LicenseRenewal[]

  @@index([tier])
  @@index([isActive])
}

model Company {
  id            String  @id @default(uuid())
  name          String
  fiscalAddress String
  vatNumber     String  @unique
  fiscalCode    String
  pec           String?
  uniqueCode    String?
  logoUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  employees              Employee[]
  packagesPurchased      PackagePurchase[]
  payments               Payment[]
  invoices               Invoice[]
  assignCourses          AssignCourse[]
  enrollments            Enrollment[]
  companyCoursePurchases CompanyCoursePurchase[]

  @@index([vatNumber])
}

model PackagePurchase {
  id          String   @id @default(uuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  purchasedAt DateTime @default(now())
  expiresAt   DateTime
  seatsTotal  Int
  seatsUsed   Int      @default(0)

  enrollments Enrollment[]
  payment     Payment?

  @@index([companyId])
}

model PackageItem {
  id        String  @id @default(uuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])

  @@unique([packageId, courseId])
}

model Package {
  id           String  @id @default(uuid())
  name         Json
  slug         String  @unique
  description  Json?
  price        Float
  seatsCount   Int
  validityDays Int     @default(180)
  isActive     Boolean @default(true)
  tenantId     String?
  tenant       Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PackageItem[]
  purchases PackagePurchase[]

  @@index([tenantId])
}

model Employee {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  jobTitle       String?
  employmentDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
}

enum CourseCategory {
  SEVESO
  MANDATORY
  CATALOG
}

enum CoursePackageType {
  SINGLE_USER
  COMPANY
}

model CoursePackage {
  id   String            @id @default(uuid())
  type CoursePackageType

  key         String?
  title       Json
  description Json?
  features    Json?

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  singleUserCourses Course[] @relation("CourseSingleUserPackage")
  companyCourses    Course[] @relation("CourseCompanyPackage")

  @@index([type])
  @@index([tenantId])
  @@index([isDefault])
}

model Course {
  id                String         @id @default(uuid())
  courseTitle       Json
  slug              String         @unique
  trainingPlanTitle Json?
  trainingPlanId    String?
  trainingActionId  String?
  description       Json?
  financingCompany  Json?
  courseStartDate   DateTime?
  courseEndDate     DateTime?
  category          CourseCategory @default(CATALOG)
  teacherId         String?
  teacher           User?          @relation("CourseTeacher", fields: [teacherId], references: [id])
  tutorId           String?
  tutorUser         User?          @relation("CourseTutor", fields: [tutorId], references: [id])

  format         CourseFormat
  navigationMode NavigationMode @default(SEQUENTIAL)

  durationMinutes  Int?
  validityDays     Int  @default(90)
  passScorePercent Int  @default(80)
  duration         Int?

  cig String?
  cup String?
  cip String?

  type                      Json?
  scormPackageUrl           String?
  courseLocation            Json?
  selectType                Json?
  sector                    Json?
  fund                      Json?
  methodology               Json?
  trainingProjectManager    Json?
  tutorName                 Json?
  vat                       Json?
  thumbnailUrl              String?
  documentUrl               String?
  videoUrl                  String?
  certificateTemplateUrl    String?
  certificateTemplateConfig Json?

  price     Float   @default(0)
  basePrice Float   @default(0)
  isActive  Boolean @default(true)
  isB2BOnly Boolean @default(false)

  tenantId            String?
  tenant              Tenant?        @relation(fields: [tenantId], references: [id])
  createdById         String?
  createdBy           User?          @relation("CourseCreatedBy", fields: [createdById], references: [id])
  // course
  singleUserPackageId String?
  singleUserPackage   CoursePackage? @relation("CourseSingleUserPackage", fields: [singleUserPackageId], references: [id])

  companyPackageId String?
  companyPackage   CoursePackage? @relation("CourseCompanyPackage", fields: [companyPackageId], references: [id])
  code             Json?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviews         CourseReview[]
  favorites       CourseFavorite[]
  lessons         Lesson[]
  enrollments     Enrollment[]
  quizzes         Quiz[]
  packageItems    PackageItem[]
  assignedTo      AssignCourse[]
  certificates    Certificate[]
  licenseeIncomes LicenseeIncome[]

  pricingTiers     CoursePricingTier[]
  companyPurchases CompanyCoursePurchase[]

  @@index([singleUserPackageId])
  @@index([companyPackageId])
  @@index([tenantId])
  @@index([createdById])
}

model CourseReview {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  rating  Int
  comment Json?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@index([tenantId])
}

model CourseFavorite {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([tenantId])
}

model Review {
  id          String   @id @default(uuid())
  name        Json     @default("{}")
  rating      Int
  comment     Json?
  isPublished Boolean  @default(false)
  isPublic    Boolean  @default(false)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

enum LessonContentType {
  SCORM
  SCORM_12
  PDF
  WORD
  EXCEL
  VIDEO_UPLOAD
  VIDEO_YOUTUBE
  FILE
}

enum ScormStatus {
  NOT_ATTEMPTED
  INCOMPLETE
  COMPLETED
  PASSED
  FAILED
  BROWSED
  UNKNOWN
}

model Lesson {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title           Json
  orderIndex      Int
  contentType     LessonContentType
  scormPackageUrl String?
  scormVersion    String?
  scormEntryPoint String?
  contentUrl      String?
  youtubeUrl      String?
  durationSecs    Int?
  isRequired      Boolean           @default(true)
  isLocked        Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress      LessonProgress[]
  scormSessions ScormSession[]

  @@index([courseId])
  @@index([courseId, orderIndex])
}

model Quiz {
  id                  String   @id @default(uuid())
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizTitle           Json
  quizType            QuizType
  passScorePercent    Int      @default(80)
  minimumScorePercent Int      @default(0)
  failScorePercent    Int      @default(0)
  isActive            Boolean  @default(true)
  isPublished         Boolean  @default(false)
  maxAttempts         Int?
  questions           Json?
  feedback            Json?
  tenantId            String?
  tenant              Tenant?  @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts QuizAttempt[]

  @@index([courseId])
  @@index([tenantId])
}

model QuizAttempt {
  id           String     @id @default(uuid())
  quizId       String
  quiz         Quiz       @relation(fields: [quizId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  scorePercent Int
  passed       Boolean
  answers      Json
  attemptedAt  DateTime   @default(now())

  @@index([enrollmentId])
  @@index([quizId])
}

model License {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  tenantId String?
  tenant   Tenant?      @relation(fields: [tenantId], references: [id])
  planId   String?
  plan     LicensePlan? @relation(fields: [planId], references: [id])

  companyName    String?
  phoneNumber    String?
  emailAddress   String?
  certifiedEmail String?

  subdomain    String? @unique
  customDomain String? @unique

  billingCycle    String? @default("YEARLY")
  maxCourses      Int     @default(100)
  maxUsers        Int     @default(1000)
  storageMb       Int     @default(10240)
  vatNumber       String?
  vatPercentage   Float   @default(22)
  priceAtPurchase Float   @default(0)

  startsAt    DateTime @default(now())
  expiresAt   DateTime
  autoRenew   Boolean  @default(false)
  isSuspended Boolean  @default(false)
  paymentId   String?  @unique
  payment     Payment? @relation(fields: [paymentId], references: [id])

  earnings LicenseeIncome[]
  renewals LicenseRenewal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([planId])
}

model LicenseRenewal {
  id                String       @id @default(uuid())
  licenseId         String
  license           License      @relation(fields: [licenseId], references: [id])
  previousExpiresAt DateTime
  newExpiresAt      DateTime
  planId            String?
  plan              LicensePlan? @relation(fields: [planId], references: [id])
  amount            Float
  paymentId         String?
  payment           Payment?     @relation(fields: [paymentId], references: [id])
  createdAt         DateTime     @default(now())

  @@index([licenseId])
  @@index([planId])
}

model LicenseeIncome {
  id        String   @id @default(uuid())
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id])
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])

  grossAmount        Float
  platformFeePercent Float @default(20)
  platformFeeAmount  Float
  licenseeAmount     Float

  currency  String    @default("EUR")
  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([licenseId])
  @@index([paymentId])
}

model Enrollment {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  packagePurchaseId String?
  packagePurchase   PackagePurchase? @relation(fields: [packagePurchaseId], references: [id])

  companyContextId String?
  companyContext   Company? @relation(fields: [companyContextId], references: [id])

  status      EnrollmentStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime

  accessLink          String?   @unique
  accessLinkToken     String?   @unique
  accessLinkExpiresAt DateTime?
  accessLinkUsed      Boolean   @default(false)
  assignedEmail       String?
  paymentId           String?   @unique
  payment             Payment?  @relation(fields: [paymentId], references: [id])

  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificate    Certificate?
  antiCheatLogs  AntiCheatLog[]

  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  scormSessions           ScormSession[]
  companyCoursePurchase   CompanyCoursePurchase? @relation(fields: [companyCoursePurchaseId], references: [id])
  companyCoursePurchaseId String?
  courseRenewals          CourseRenewal[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Payment {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  enrollmentId String?     @unique
  enrollment   Enrollment? @relation()
  licenseId    String?     @unique
  license      License?    @relation()

  type     PaymentType
  status   PaymentStatus @default(PENDING)
  amount   Float
  currency String        @default("EUR")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  stripeSessionId       String?
  stripePaymentIntentId String?
  stripeCustomerId      String?

  packagePurchaseId String?          @unique
  packagePurchase   PackagePurchase? @relation(fields: [packagePurchaseId], references: [id])

  archiveSubscriptionId String?              @unique
  archiveSubscription   ArchiveSubscription? @relation(fields: [archiveSubscriptionId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  invoice                      Invoice?
  licenseeIncome               LicenseeIncome[]
  renewalPayments              LicenseRenewal[]
  courseRenewal                CourseRenewal?
  companyCoursePurchaseRenewal CompanyCoursePurchaseRenewal?
  companyCoursePurchase        CompanyCoursePurchase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([tenantId])
  @@index([licenseId])
  @@index([enrollmentId])
}

model CourseRenewal {
  id                String     @id @default(uuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id])
  previousExpiresAt DateTime
  newExpiresAt      DateTime
  amount            Float
  paymentId         String?    @unique
  payment           Payment?   @relation(fields: [paymentId], references: [id])
  createdAt         DateTime   @default(now())

  @@index([enrollmentId])
}

model CompanyCoursePurchaseRenewal {
  id                      String                @id @default(uuid())
  companyCoursePurchaseId String
  companyCoursePurchase   CompanyCoursePurchase @relation(fields: [companyCoursePurchaseId], references: [id])
  previousExpiresAt       DateTime
  newExpiresAt            DateTime
  seatsTotal              Int
  pricePerUser            Float
  amount                  Float
  paymentId               String?               @unique
  payment                 Payment?              @relation(fields: [paymentId], references: [id])
  createdAt               DateTime              @default(now())

  @@index([companyCoursePurchaseId])
}

model LessonProgress {
  id            String       @id @default(uuid())
  enrollmentId  String
  enrollment    Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id])
  completed     Boolean      @default(false)
  completedAt   DateTime?
  scormStatus   ScormStatus?
  scormScore    Float?
  scormPassed   Boolean?
  timeSpentSecs Int          @default(0)
  scormData     Json?
  startedAt     DateTime?
  location      String?

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model ScormSession {
  id           String      @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id])
  lessonId     String
  lesson       Lesson      @relation(fields: [lessonId], references: [id])
  launchedAt   DateTime    @default(now())
  exitedAt     DateTime?
  sessionSecs  Int         @default(0)
  cmiData      Json?
  status       ScormStatus @default(NOT_ATTEMPTED)
  score        Float?
  location     String?
  ipAddress    String?
  userAgent    String?

  @@index([enrollmentId])
  @@index([lessonId])
  @@index([launchedAt])
}

model Certificate {
  id           String     @id @default(uuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  pdfUrl            String
  qrCode            String?
  timestampProof    String?
  companyLogoUrl    String?
  status            CertificateStatus @default(ISSUED)
  issuedAt          DateTime          @default(now())
  downloadableUntil DateTime
  editUnlockedOnce  Boolean           @default(false)
  archived          Boolean           @default(false)
  archivedAt        DateTime?
  downloadCount     Int               @default(0)
  lastDownloadedAt  DateTime?

  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([tenantId])
}

model AntiCheatLog {
  id           String         @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id])
  lessonId     String?
  eventType    AntiCheatEvent
  occurredAt   DateTime       @default(now())
  metadata     Json?

  @@index([enrollmentId])
}

model AssignCourse {
  id String @id @default(uuid())

  userId String
  user   User   @relation("AssignedToUser", fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  assignedById String?
  assignedBy   User?   @relation("AssignedByUser", fields: [assignedById], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([assignedById])
  @@index([companyId])
}

model ArchiveSubscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  isActive  Boolean   @default(false)
  storageMb Int       @default(1024)
  startedAt DateTime?
  expiresAt DateTime?

  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  payment  Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(uuid())
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  status     InvoiceStatus @default(NOT_REQUESTED)
  externalId String?
  pdfUrl     String?
  xmlUrl     String?
  issuedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  maxUses       Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  applicableTo  CouponTarget
  isActive      Boolean      @default(true)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime  @default(now())
  payments  Payment[]

  @@index([tenantId])
}

model Notification {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  type    String
  title   Json
  message Json
  read    Boolean  @default(false)
  sentAt  DateTime @default(now())

  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
}

model Alert {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  severity            AlertSeverity
  message             Json
  relatedEnrollmentId String?
  dismissed           Boolean       @default(false)
  createdAt           DateTime      @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
}

model SupportTicket {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  subject     Json?
  message     Json?
  answer      Json?
  question    Json?
  attachments String?
  status      TicketStatus @default(OPEN)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
}

model CalendarSync {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  provider     CalendarProvider
  accessToken  String?
  refreshToken String?
  syncToken    String?
  lastSyncedAt DateTime?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model AccessLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String
  device    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  changes   Json?
  immutable Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  subdomain    String?  @unique
  customDomain String?  @unique
  logoUrl      String?
  primaryColor String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId String? @unique
  owner   User?   @relation("TenantOwner", fields: [ownerId], references: [id])

  users                 User[]                 @relation("TenantUsers")
  courses               Course[]
  licenses              License[]
  payments              Payment[]
  packages              Package[]
  quizzes               Quiz[]
  coupons               Coupon[]
  notifications         Notification[]
  alerts                Alert[]
  supportTickets        SupportTicket[]
  archiveSubscriptions  ArchiveSubscription[]
  certificates          Certificate[]
  reviews               Review[]
  staffMembers          StaffMember[]
  serviceRequests       ServiceRequest[]
  contacts              Contact[]
  collaborationRequests CollaborationRequest[]
  courseReviews         CourseReview[]
  courseFavorites       CourseFavorite[]
  coursePackages        CoursePackage[]

  @@index([subdomain])
  @@index([customDomain])
}

model StaffMember {
  id String @id @default(uuid())

  role   StaffRole
  status StaffMemberStatus @default(DRAFT)

  firstName String?
  lastName  String?

  companyName String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdById String?
  createdBy   User?   @relation("StaffCreatedBy", fields: [createdById], references: [id])

  confirmedAt DateTime?

  documents StaffDocument[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId])
  @@index([role])
  @@index([createdById])
}

model StaffDocument {
  id String @id @default(uuid())

  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  documentType String

  fileName String
  fileUrl  String
  mimeType String
  fileSize Int?

  uploadedAt DateTime @default(now())

  @@index([staffMemberId])
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  password          String?
  level             UserLevel       @default(PRIVATE_USER)
  status            UserStatus      @default(PENDING)
  isVerified        Boolean         @default(false)
  isActive          Boolean         @default(true)
  verifiedAt        DateTime?
  avatar            String?
  preferredLanguage SupportedLocale @default(it)

  firstName        String?
  lastName         String?
  birthDate        DateTime?
  city             String?
  country          String?
  traineeTaxCode   String?
  residenceAddress String?
  membership       String?
  companyName      String?
  companyAddress   String?
  companyTaxCode   String?
  companyVatNumber String?
  companyPosition  String?
  citizenship      Citizenship?
  serviceType      String?
  contactNumber    String?

  profileCompleted Boolean @default(false)
  stripeCustomerId String? @unique

  otpCode              String?
  otpExpires           DateTime?
  otpPurpose           String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?

  consentGiven       Boolean   @default(false)
  consentDate        DateTime?
  marketingConsent   Boolean   @default(false)
  dataRetentionUntil DateTime?
  alertsOptOut       Boolean   @default(false)

  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id])
  employee  Employee[]

  tenantId    String?
  tenant      Tenant? @relation("TenantUsers", fields: [tenantId], references: [id])
  ownedTenant Tenant? @relation("TenantOwner")

  enrollments         Enrollment[]
  certificates        Certificate[]
  payments            Payment[]
  invoices            Invoice[]
  notifications       Notification[]
  alerts              Alert[]
  accessLogs          AccessLog[]
  auditLogs           AuditLog[]
  coursesCreated      Course[]             @relation("CourseCreatedBy")
  coursesAsTeacher    Course[]             @relation("CourseTeacher")
  coursesAsTutor      Course[]             @relation("CourseTutor")
  archiveSubscription ArchiveSubscription?
  supportTickets      SupportTicket[]
  license             License?
  assignedCourses     AssignCourse[]       @relation("AssignedToUser")
  assignedByMe        AssignCourse[]       @relation("AssignedByUser")
  calendarSyncs       CalendarSync[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviews         CourseReview[]
  courseFavorites CourseFavorite[]
  staffMembers    StaffMember[]    @relation("StaffCreatedBy")
  serviceRequests ServiceRequest[] @relation("ServiceRequestSubmittedBy")

  @@index([email])
  @@index([tenantId])
  @@index([companyId])
}

model ServiceRequest {
  id          String  @id @default(uuid())
  serviceName String?
  firstName   String
  lastName    String

  companyName String?
  vatNumber   String?

  phone     String
  email     String
  message   String?              @db.Text
  status    ServiceRequestStatus @default(NEW)
  adminNote String?              @db.Text
  handledAt DateTime?
  userId    String?
  user      User?                @relation("ServiceRequestSubmittedBy", fields: [userId], references: [id])

  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  documents String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

enum ContactStatus {
  PENDING
  CONTACTED
  RESOLVED
}

model Contact {
  id String @id @default(uuid())

  firstName  String
  lastName   String
  vat        String?
  phone      Int
  email      String
  message    String?
  agencyName String?
  status     ContactStatus @default(PENDING)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([createdAt])
  @@index([status])
}

model CollaborationRequest {
  id String @id @default(uuid())

  companyName       String
  collaborationType String

  contactName  String
  contactEmail String
  contactPhone String

  companySize         String?
  businessDescription String?
  goals               String?

  status String  @default("PENDING")
  notes  String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactEmail])
  @@index([status])
  @@index([createdAt])
}

model PlatformSetting {
  id String @id @default("global")

  downloadPermissionEnabled  Boolean @default(true)
  newUserRegistrationEnabled Boolean @default(true)
  paymentProcessingEnabled   Boolean @default(true)
  maintenanceModeEnabled     Boolean @default(false)
  maintenanceMessage         Json?

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
